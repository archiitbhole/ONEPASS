{
  "name": "@onepass/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node .next/standalone/apps/web/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:credential": "tsx src/db/seed-credential.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "db:push": "node scripts/db-push.mjs",
    "test:watch": "vitest",
    "db:refresh": "tsx src/db/refresh.ts",
    "security:sweep": "tsx src/db/run-detect.ts",
    "security:scenario": "tsx src/db/run-security-scenario.ts",
    "travel:settle-cashback": "tsx src/db/settle-cashback.ts",
    "products:backfill": "tsx src/db/backfill-products.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@node-rs/argon2": "^2.0.2",
    "@onepass/pass": "*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^5.4.1",
    "motion": "^13.2.0",
    "next": "^15.1.3",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2"
  }
}
