{
  "name": "@onepass/pass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./qr": {
      "types": "./dist/qr.d.ts",
      "default": "./dist/qr.js"
    }
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "@types/node": "^22.7.5"
  }
}
